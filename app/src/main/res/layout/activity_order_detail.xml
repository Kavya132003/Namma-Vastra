<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF3EE">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF8F2"
            android:padding="18dp"
            android:elevation="6dp">

            <TextView
                android:id="@+id/detailCustomer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#3E2723" />

            <TextView
                android:id="@+id/detailProducts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Products"
                android:textSize="18sp"
                android:layout_marginTop="10dp"
                android:textColor="#5D4037" />

            <TextView
                android:id="@+id/detailTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total"
                android:textSize="18sp"
                android:layout_marginTop="10dp"
                android:textColor="#6D4C41" />

            <TextView
                android:id="@+id/detailStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"
                android:textColor="#FF9800"
                android:padding="6dp"
                android:background="#FFF3E0" />
        </LinearLayout>

        <!-- SPACING -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- TIMELINE HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order Timeline"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#3E2723"
            android:layout_marginBottom="10dp" />

        <!-- TIMELINE INCLUDE -->
        <include layout="@layout/item_order_timeline" />

    </LinearLayout>

</ScrollView>